{
  "$schema": "https://openclaw.ai/config.json",
  "plugins": {
    "entries": {
      "context-mode": {
        "enabled": true
      }
    },
    "slots": {
      "contextEngine": "context-mode"
    }
  },
  "mcp": {
    "servers": {
      "context-mode": {
        "command": "node",
        "args": [
          "./server.bundle.mjs"
        ]
      }
    }
  }
}
